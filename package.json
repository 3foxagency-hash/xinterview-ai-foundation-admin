{
  "name": "xinterview",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript backend-schema/xinterview-schema.yaml -o lib/api/generated/schema.ts",
    "api:check": "npm run api:types && git diff --exit-code lib/api/generated/schema.ts",
    "mocks:init": "msw init public/ --save"
  },
  "dependencies": {
    "@cloudflare/speedtest": "^1.13.1",
    "@hookform/resolvers": "^5.9.1",
