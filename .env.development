# Defaults for `npm run dev`. COMMITTED ON PURPOSE — contains no secrets.
#
# This is what makes `git clone && npm install && npm run dev` work with no
# setup: mocks are on, so the app runs without a backend on localhost:8080.
#
# Next.js loads env files in this order, first match wins:
#   .env.local        ← yours, gitignored, overrides everything below
#   .env.development  ← this file, shared defaults for dev
#   .env              ← gitignored
#
# To point at a real backend instead, create .env.local:
#   NEXT_PUBLIC_API_MOCKING=disabled
#   NEXT_PUBLIC_API_BASE_URL=https://xdev.xinterview.xyz
#
# Or use the script that does it for you:  npm run dev:live

NEXT_PUBLIC_APP_ENV=local

# Only used when mocking is off or partial. MSW intercepts before any request
# reaches this host, so nothing needs to be listening on it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# enabled  = MSW serves everything (the default, so a clone just works)
# partial  = MSW serves only NEXT_PUBLIC_MOCK_RESOURCES, the rest hit the real API
# disabled = no mocking
NEXT_PUBLIC_API_MOCKING=enabled

# Only read when NEXT_PUBLIC_API_MOCKING=partial.
# Comma-separated resource names: auth, jobs
NEXT_PUBLIC_MOCK_RESOURCES=
