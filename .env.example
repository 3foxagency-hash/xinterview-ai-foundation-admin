# Copy to .env.local and fill in. .env.local is gitignored.
#
# APP_ENV and API_MOCKING are independent axes. The common local setup is
# APP_ENV=local with API_MOCKING=enabled.

# local | development | staging | production
NEXT_PUBLIC_APP_ENV=local

# Backend origin. The /api/v1 prefix is added by lib/api/client.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# enabled  = MSW serves everything
# partial  = MSW serves only NEXT_PUBLIC_MOCK_RESOURCES, rest hits the real API
# disabled = no mocking (forced in production regardless of this value)
NEXT_PUBLIC_API_MOCKING=enabled

# Only read when NEXT_PUBLIC_API_MOCKING=partial.
# Comma-separated: auth,jobs,candidates,reports,settings
NEXT_PUBLIC_MOCK_RESOURCES=
