# Copy to .env.local and fill in. .env.local is gitignored.

# local | development | staging | production
NEXT_PUBLIC_APP_ENV=local

# Backend origin. Paths are used as-is by lib/api/client.ts — no /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Mocking — enabled | disabled | partial. See docs/msw-mocking.md.
NEXT_PUBLIC_API_MOCKING=enabled
# csv of resource names, only read when NEXT_PUBLIC_API_MOCKING=partial
NEXT_PUBLIC_MOCK_RESOURCES=auth,user-management
